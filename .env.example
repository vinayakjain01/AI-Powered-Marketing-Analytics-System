# Copy to .env and fill in. .env is git-ignored - never commit real secrets.

# Any SQLAlchemy URL. Local Postgres, or hosted (Supabase / Neon) for deployment.
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/campaign

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# "gemini" (needs key) or "tfidf" (offline). Empty = gemini if a key is set, else tfidf.
EMBEDDINGS=

# Agent limits
MAX_ROWS=200
QUERY_TIMEOUT_MS=10000
AGENT_MAX_STEPS=8

# Comma-separated origins allowed to call the API from a browser (frontend dev server)
CORS_ORIGINS=http://localhost:5173
